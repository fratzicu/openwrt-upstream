#!/bin/sh
# rpcd plugin for the LuCI "Storage" page
#   status:    SATA/USB disks with their partitions, the file systems that can
#              be created, and the state of a running or finished
#              initialisation (/tmp/disk-init.*)
#   init:      start /usr/sbin/disk-init in the background (formatting a large
#              disk takes longer than an rpcd call may)
#   shares:    storage folders (mounted disk partitions) with their SMB, NFS and
#              anonymous FTP sharing, and the SMB and FTP users
#   set_share: change the sharing of one folder
#   set_user:  add, change or delete an SMB or FTP user
#
# Everything is kept where OpenWrt keeps it, so it can also be changed by hand
# or on the Network Shares page:
#   SMB shares      /etc/config/ksmbd
#   SMB users       system account (no shell) + /etc/ksmbd/ksmbdpwd.db
#   FTP             /etc/vsftpd.conf, users in /etc/vsftpd/vsftpd.users,
#                   per-user folder/write access in /etc/vsftpd/users/<name>,
#                   system account (no shell) with its password in /etc/shadow
#   NFS             /etc/exports

. /usr/share/libubox/jshn.sh
. /lib/functions.sh

STATE=/tmp/disk-init.state
LOG=/tmp/disk-init.log
PWDDB=/etc/ksmbd/ksmbdpwd.db
VSFTPD_CONF=/etc/vsftpd.conf
FTP_USERS=/etc/vsftpd/vsftpd.users
FTP_USERDIR=/etc/vsftpd/users
NOT_USERS='root daemon ftp network nobody anonymous'

reply_error() {
	json_init
	json_add_string error "$*"
	json_dump
	exit 0
}

blkval() {	# blkval <dev> <KEY>: value from "block info"
	block info "$1" 2>/dev/null | sed -n "s/.* $2=\"\([^\"]*\)\".*/\1/p"
}

add_disk() {
	local d=$1 sys=/sys/block/$1 p dev mnt bus

	case "$(readlink -f $sys)" in
	*/usb*) bus=usb ;;
	*/ata*) bus=sata ;;
	*) bus=other ;;
	esac

	json_add_object
	json_add_string name "$d"
	json_add_string bus "$bus"
	json_add_string vendor "$(cat $sys/device/vendor 2>/dev/null | sed 's/ *$//')"
	json_add_string model "$(cat $sys/device/model 2>/dev/null | sed 's/ *$//')"
	json_add_double size "$(( $(cat $sys/size) / 2 ))"	# KiB
	json_add_array partitions
	for p in $sys/${d}*; do
		[ -e "$p/partition" ] || continue
		dev=/dev/${p##*/}
		mnt=$(awk -v d="$dev" '$1 == d { print $2; exit }' /proc/mounts)
		json_add_object
		json_add_string name "${p##*/}"
		json_add_double size "$(( $(cat $p/size) / 2 ))"
		json_add_string type "$(blkval $dev TYPE)"
		json_add_string label "$(blkval $dev LABEL)"
		json_add_string uuid "$(blkval $dev UUID)"
		json_add_string mount "$mnt"
		json_close_object
	done
	json_close_array
	json_close_object
}

# storage folders: mount points of SATA/USB disk partitions
folders() {
	awk '$1 ~ "^/dev/sd[a-z][0-9]*$" && $2 != "/" && $2 !~ "^/(overlay|rom)" { print $1, $2, $3 }' /proc/mounts
}

is_folder() {
	folders | awk -v p="$1" '$2 == p { f = 1 } END { exit !f }'
}

smb_users() {
	[ -f $PWDDB ] && cut -d: -f1 $PWDDB
}

ftp_users() {
	[ -f $FTP_USERS ] && grep -v -x -E 'anonymous|ftp|' $FTP_USERS
}

in_list() {	# in_list <word> <list>
	echo " $2 " | tr '\n' ' ' | grep -q " $1 "
}

conf_get() {	# conf_get <key>: value from vsftpd.conf
	sed -n "s/^$1=//p" $VSFTPD_CONF 2>/dev/null | tail -n 1
}

conf_set() {	# conf_set <key> <value>: set a vsftpd.conf line (replaces the
		# first, commented or not, and drops the other ones)
	awk -v k="$1" -v v="$2" '
		$0 ~ "^#?" k "=" { if (!d) print k "=" v; d = 1; next }
		{ print }
		END { if (!d) print k "=" v }' $VSFTPD_CONF > $VSFTPD_CONF.new &&
		cat $VSFTPD_CONF.new > $VSFTPD_CONF
	rm -f $VSFTPD_CONF.new
}

# --- shares ---------------------------------------------------------------

smb_find() {	# sets SMB_SEC to the ksmbd share with path $SMB_PATH
	local path
	config_get path "$1" path
	[ -z "$SMB_SEC" ] && [ "$path" = "$SMB_PATH" ] && SMB_SEC=$1
}

smb_section() {	# smb_section <path>
	SMB_SEC=
	SMB_PATH=$1
	[ -e /etc/config/ksmbd ] || return
	config_load ksmbd
	config_foreach smb_find share
}

add_folder() {
	local dev=$1 path=$2 fstype=$3 guest users ro name exp

	json_add_object
	json_add_string path "$path"
	json_add_string dev "$dev"
	json_add_string fstype "$fstype"
	json_add_string label "$(blkval $dev LABEL)"
	json_add_double free "$(df -k "$path" | awk 'NR == 2 { print $4 }')"

	smb_section "$path"
	if [ -n "$SMB_SEC" ]; then
		config_get name "$SMB_SEC" name
		config_get guest "$SMB_SEC" guest_ok
		config_get users "$SMB_SEC" users
		config_get ro "$SMB_SEC" read_only
		json_add_string smb "$( [ -n "$users" ] && echo users || echo guest )"
		json_add_string smb_name "$name"
		json_add_string smb_users "$(echo $users | tr ',' ' ')"
		json_add_boolean smb_ro "$( [ "$ro" = yes ] && echo 1 || echo 0 )"
	else
		json_add_string smb off
	fi

	json_add_boolean ftp_anon "$( [ "$(conf_get anonymous_enable)" = YES ] &&
		[ "$(conf_get anon_root)" = "$path" ] && echo 1 || echo 0 )"

	exp=$(awk -v p="$path" '$1 == p { $1 = ""; print; exit }' /etc/exports 2>/dev/null)
	if [ -n "$exp" ]; then
		json_add_boolean nfs 1
		json_add_string nfs_clients "$(echo $exp | sed 's/([^)]*)//g')"
		json_add_boolean nfs_ro "$(echo "$exp" | grep -q '(ro[,)]' && echo 1 || echo 0)"
	else
		json_add_boolean nfs 0
	fi
	json_close_object
}

lan_subnet() {
	local addr
	. /lib/functions/network.sh
	network_get_subnet addr lan || return
	eval "$(/bin/ipcalc.sh "$addr")"
	echo "$NETWORK/$PREFIX"
}

do_shares() {
	local u r w f dev path fstype

	json_init
	json_add_object services
	json_add_boolean smb "$( [ -x /etc/init.d/ksmbd ] && echo 1 || echo 0 )"
	json_add_boolean ftp "$( [ -x /etc/init.d/vsftpd ] && echo 1 || echo 0 )"
	json_add_boolean nfs "$( [ -x /etc/init.d/nfsd ] && echo 1 || echo 0 )"
	json_close_object
	json_add_string lan_subnet "$(lan_subnet)"

	json_add_array folders
	f=$(folders)
	while read -r dev path fstype; do
		[ -n "$dev" ] && add_folder "$dev" "$path" "$fstype"
	done <<-EOF
	$f
	EOF
	json_close_array

	json_add_array smb_users
	for u in $(smb_users); do json_add_string "" "$u"; done
	json_close_array

	json_add_array ftp_users
	for u in $(ftp_users); do
		f=$FTP_USERDIR/$u
		r=$(sed -n 's/^local_root=//p' $f 2>/dev/null)
		w=$(sed -n 's/^write_enable=//p' $f 2>/dev/null)
		json_add_object
		json_add_string name "$u"
		json_add_string root "${r:-/mnt}"
		json_add_boolean write "$( [ "$w" = NO ] && echo 0 || echo 1 )"
		json_close_object
	done
	json_close_array
	json_dump
}

service_on() {	# service_on <init script>: enable and (re)start
	/etc/init.d/$1 enable
	/etc/init.d/$1 restart >/dev/null 2>&1
}

service_off() {
	/etc/init.d/$1 stop >/dev/null 2>&1
	/etc/init.d/$1 disable
}

vsftpd_base() {	# the settings the Storage page relies on
	mkdir -p $FTP_USERDIR
	touch $FTP_USERS
	conf_set listen YES
	conf_set local_enable YES
	conf_set write_enable YES
	conf_set local_umask 000
	conf_set check_shell NO
	conf_set chroot_local_user YES
	conf_set allow_writeable_chroot YES
	conf_set userlist_enable YES
	conf_set userlist_deny NO
	conf_set userlist_file $FTP_USERS
	conf_set user_config_dir $FTP_USERDIR
	conf_set no_anon_password YES
	conf_set anon_upload_enable NO
	conf_set anon_mkdir_write_enable NO
	conf_set anon_other_write_enable NO
}

vsftpd_apply() {
	if [ "$(conf_get anonymous_enable)" = YES ] || [ -n "$(ftp_users)" ]; then
		service_on vsftpd
	else
		service_off vsftpd
	fi
}

do_set_share() {
	local path smb smb_users smb_ro ftp_anon nfs nfs_clients nfs_ro
	local name opt c line u

	json_get_vars path smb smb_users smb_ro ftp_anon nfs nfs_clients nfs_ro
	is_folder "$path" || reply_error "$path is not a mounted storage folder"

	# SMB
	if [ -x /etc/init.d/ksmbd ]; then
		smb_section "$path"
		case "$smb" in
		off)
			[ -n "$SMB_SEC" ] && uci delete ksmbd.$SMB_SEC
			;;
		guest|users)
			if [ "$smb" = users ]; then
				smb_users=$(echo $smb_users | tr ',' ' ')
				[ -n "$smb_users" ] || reply_error "choose at least one SMB user"
				for u in $smb_users; do
					in_list "$u" "$(smb_users)" || reply_error "unknown SMB user $u"
				done
			else
				smb_users=
			fi
			if [ -z "$SMB_SEC" ]; then
				SMB_SEC=$(uci add ksmbd share)
				name=${path##*/}
				uci set ksmbd.$SMB_SEC.name="$name"
				uci set ksmbd.$SMB_SEC.path="$path"
				uci set ksmbd.$SMB_SEC.browseable=yes
				uci set ksmbd.$SMB_SEC.create_mask=0666
				uci set ksmbd.$SMB_SEC.dir_mask=0777
				uci set ksmbd.$SMB_SEC.force_create_mode=0666
				uci set ksmbd.$SMB_SEC.force_directory_mode=0777
			fi
			if [ "$smb" = guest ]; then
				uci set ksmbd.$SMB_SEC.guest_ok=yes
				uci -q delete ksmbd.$SMB_SEC.users
			else
				uci set ksmbd.$SMB_SEC.guest_ok=no
				uci set ksmbd.$SMB_SEC.users="$smb_users"
			fi
			uci set ksmbd.$SMB_SEC.read_only="$( [ "$smb_ro" = 1 ] && echo yes || echo no )"
			;;
		esac
		uci commit ksmbd
		service_on ksmbd
	fi

	# anonymous FTP (one folder, read-only)
	if [ -x /etc/init.d/vsftpd ]; then
		vsftpd_base
		if [ "$ftp_anon" = 1 ]; then
			conf_set anonymous_enable YES
			conf_set anon_root "$path"
			grep -q -x anonymous $FTP_USERS || echo anonymous >> $FTP_USERS
			grep -q -x ftp $FTP_USERS || echo ftp >> $FTP_USERS
		elif [ "$(conf_get anon_root)" = "$path" ]; then
			conf_set anonymous_enable NO
			sed -i '/^anon_root=/d' $VSFTPD_CONF
			sed -i -E '/^(anonymous|ftp)$/d' $FTP_USERS
		fi
		vsftpd_apply
	fi

	# NFS
	if [ -x /etc/init.d/nfsd ]; then
		touch /etc/exports
		awk -v p="$path" '$1 != p' /etc/exports > /etc/exports.new
		if [ "$nfs" = 1 ]; then
			echo "$nfs_clients" | grep -q -E '^[][A-Za-z0-9.:/*_ -]+$' ||
				{ rm -f /etc/exports.new; reply_error "NFS clients: addresses, networks (a.b.c.d/nn), host names or *"; }
			opt="$( [ "$nfs_ro" = 1 ] && echo ro || echo rw ),sync,no_subtree_check,insecure,all_squash,anonuid=65534,anongid=65534"
			# FAT, exFAT and NTFS have no stable inode numbers to derive one from
			opt="$opt,fsid=$(printf %d 0x$(echo "$path" | md5sum | cut -c1-7))"
			line=$path
			for c in $nfs_clients; do line="$line $c($opt)"; done
			echo "$line" >> /etc/exports.new
		fi
		mv /etc/exports.new /etc/exports
		if grep -q '^/' /etc/exports; then
			service_on nfsd
		else
			service_off nfsd
		fi
	fi

	json_init
	json_add_boolean ok 1
	json_dump
}

# --- users ----------------------------------------------------------------

next_uid() {
	local uid=1000
	while cut -d: -f3 /etc/passwd | grep -q -x $uid; do uid=$((uid + 1)); done
	echo $uid
}

account_ensure() {	# account_ensure <name>: system account without a shell
	local shell uid
	if user_exists "$1"; then
		shell=$(awk -F: -v n="$1" '$1 == n { print $7 }' /etc/passwd)
		uid=$(awk -F: -v n="$1" '$1 == n { print $3 }' /etc/passwd)
		[ "$shell" = /bin/false ] && { [ "$uid" -ge 1000 ] ||
			in_list "$1" "$(smb_users) $(ftp_users)"; } ||
			reply_error "$1 is a system account, choose another name"
		return
	fi
	user_add "$1" "$(next_uid)" 100 "$1" /mnt /bin/false
	sed -i "s/^$1:x:/$1:*:/" /etc/shadow
}

account_drop() {	# account_drop <name>: remove an account this page made
	local uid
	uid=$(awk -F: -v n="$1" '$1 == n { print $3 }' /etc/passwd)
	[ -n "$uid" ] && [ "$uid" -ge 1000 ] || return
	lock /var/lock/passwd
	sed -i "/^$1:/d" /etc/passwd /etc/shadow
	lock -u /var/lock/passwd
}

account_home() {	# account_home <name> <dir>
	awk -F: -v OFS=: -v n="$1" -v h="$2" '$1 == n { $6 = h } { print }' \
		/etc/passwd > /etc/passwd.new && cat /etc/passwd.new > /etc/passwd
	rm -f /etc/passwd.new
}

smb_drop_user() {	# remove a user from the "users" lists of the shares
	local users u keep
	config_get users "$1" users
	in_list "$DROP" "$(echo $users | tr ',' ' ')" || return
	keep=
	for u in $(echo $users | tr ',' ' '); do
		[ "$u" = "$DROP" ] || keep="$keep${keep:+ }$u"
	done
	if [ -n "$keep" ]; then
		uci set ksmbd."$1".users="$keep"
	else
		# nobody left: keep the share closed rather than opening it to guests
		uci set ksmbd."$1".users="$DROP"
		SMB_ORPHAN=1
	fi
}

do_set_user() {
	local service action name password root write conf

	json_get_vars service action name password root write
	echo "$name" | grep -q -E '^[a-z_][a-z0-9_-]{0,31}$' ||
		reply_error "user name: up to 32 small letters, digits, - or _, not starting with a digit or -"
	in_list "$name" "$NOT_USERS" && reply_error "$name is reserved"
	case "$action" in
	add|set)
		[ "$action" = add ] || [ -n "$password" ] || [ "$service" = ftp ] ||
			reply_error "enter a password"
		if [ -n "$password" ] || [ "$action" = add ]; then
			[ ${#password} -ge 4 ] || reply_error "the password needs at least 4 characters"
			case "$password" in *"
"*) reply_error "the password cannot contain a line break" ;; esac
		fi
		;;
	delete) ;;
	*) reply_error "invalid action" ;;
	esac

	case "$service" in
	smb)
		[ -x /usr/sbin/ksmbd.adduser ] || reply_error "ksmbd is not installed"
		conf=/etc/ksmbd/ksmbd.conf
		[ -e $conf ] || conf=/etc/ksmbd/ksmbd.conf.template
		case "$action" in
		add|set)
			[ "$action" = add ] && in_list "$name" "$(smb_users)" &&
				reply_error "SMB user $name exists already"
			[ "$action" = set ] && ! in_list "$name" "$(smb_users)" &&
				reply_error "no SMB user $name"
			account_ensure "$name"
			printf '%s\n%s\n' "$password" "$password" |
				ksmbd.adduser -C $conf "$name" >/dev/null 2>&1 ||
				reply_error "ksmbd.adduser failed"
			;;
		delete)
			ksmbd.adduser -C $conf -d "$name" >/dev/null 2>&1
			DROP=$name SMB_ORPHAN=
			config_load ksmbd
			config_foreach smb_drop_user share
			uci commit ksmbd
			/etc/init.d/ksmbd running && /etc/init.d/ksmbd restart >/dev/null 2>&1
			in_list "$name" "$(ftp_users)" || account_drop "$name"
			;;
		esac
		;;
	ftp)
		[ -x /etc/init.d/vsftpd ] || reply_error "vsftpd is not installed"
		vsftpd_base
		case "$action" in
		add|set)
			[ "$action" = add ] && in_list "$name" "$(ftp_users)" &&
				reply_error "FTP user $name exists already"
			[ "$action" = set ] && ! in_list "$name" "$(ftp_users)" &&
				reply_error "no FTP user $name"
			root=${root:-/mnt}
			[ "$root" = /mnt ] || is_folder "$root" ||
				reply_error "$root is not a storage folder"
			account_ensure "$name"
			if [ -n "$password" ]; then
				printf '%s\n%s\n' "$password" "$password" |
					passwd "$name" >/dev/null 2>&1 || reply_error "passwd failed"
			fi
			account_home "$name" "$root"
			printf 'local_root=%s\nwrite_enable=%s\n' "$root" \
				"$( [ "$write" = 0 ] && echo NO || echo YES )" > $FTP_USERDIR/$name
			grep -q -x "$name" $FTP_USERS || echo "$name" >> $FTP_USERS
			;;
		delete)
			sed -i "/^$name\$/d" $FTP_USERS
			rm -f $FTP_USERDIR/$name
			if in_list "$name" "$(smb_users)"; then
				user_exists "$name" && sed -i "s/^$name:[^:]*:/$name:*:/" /etc/shadow
			else
				account_drop "$name"
			fi
			;;
		esac
		vsftpd_apply
		;;
	*)
		reply_error "invalid service"
		;;
	esac

	json_init
	json_add_boolean ok 1
	[ -n "$SMB_ORPHAN" ] && json_add_string warning \
		"a share had $name as its only user; it stays closed until you choose other users"
	json_dump
}

case "$1" in
list)
	cat <<-EOF
	{
		"status": {},
		"init": { "disk": "str", "label": "str", "fstype": "str" },
		"shares": {},
		"set_share": { "path": "str", "smb": "str", "smb_users": "str", "smb_ro": true,
			"ftp_anon": true, "nfs": true, "nfs_clients": "str", "nfs_ro": true },
		"set_user": { "service": "str", "action": "str", "name": "str",
			"password": "str", "root": "str", "write": true }
	}
	EOF
	;;
call)
	case "$2" in
	status)
		json_init
		json_add_array disks
		for d in /sys/block/sd*; do
			[ -e "$d" ] && add_disk "${d##*/}"
		done
		json_close_array
		json_add_array fstypes
		for t in $(/usr/sbin/disk-init fstypes); do json_add_string "" "$t"; done
		json_close_array
		json_add_string state "$(cat $STATE 2>/dev/null)"
		json_add_string log "$(tail -n 40 $LOG 2>/dev/null)"
		json_dump
		;;
	init)
		read -r input
		json_load "$input"
		json_get_vars disk label fstype
		[ "$(cat $STATE 2>/dev/null)" = running ] &&
			reply_error "an initialisation is already running"
		case "$disk" in
		sd[a-z]) ;;
		*) reply_error "invalid disk" ;;
		esac
		echo "$label" | grep -q -E '^[A-Za-z0-9_-]{1,16}$' ||
			reply_error "name: 1-16 letters, digits, - or _"
		in_list "$fstype" "$(/usr/sbin/disk-init fstypes)" ||
			reply_error "file system $fstype is not available"
		echo running > $STATE
		: > $LOG
		( /usr/sbin/disk-init "$disk" "$label" "$fstype" >> $LOG 2>&1 \
			&& echo done > $STATE || echo failed > $STATE ) \
			</dev/null >/dev/null 2>&1 &
		echo '{ "started": true }'
		;;
	shares)
		do_shares
		;;
	set_share)
		read -r input
		json_load "$input"
		do_set_share
		;;
	set_user)
		read -r input
		json_load "$input"
		do_set_user
		;;
	esac
	;;
esac
